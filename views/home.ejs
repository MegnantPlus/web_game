<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pickleball Champion</title>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body onload="document.body.classList.add('loaded')" class="loading">
    <!-- PARTICLES BG -->
    <canvas id="particleCanvas"></canvas>

    <!-- HEADER -->
    <header class="header">
        <div class="title">
            <div class="header-logo">
                <img src="img/ChatGPT Image 17_13_12 20 thg 12, 2025.png" alt="PICKLEBALL CHAMPION">
            </div>
            
            <ul class="header-nav">
                <li><a href="#introduction">Story</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#donate">Donate</a></li>
                <li><a href="#updatesSection">News</a></li>
            </ul>
        </div>

        <!-- AUTH SECTION -->
        <div class="auth-section" id="authSection">
            <!-- Not logged in -->
            <div class="auth-buttons" id="authButtons">
                <button class="sign-in-button" onclick="showAuthModal('login')">Log in</button>
                <button class="sign-up-button" onclick="showAuthModal('signup')">Sign up</button>
            </div>

            <!-- Logged in -->
            <div class="user-profile" id="userProfile" style="display: none;">
                <div class="profile-info">
                    <span class="user-avatar" id="userAvatar">👤</span>
                    <span class="username" id="usernameDisplay"></span>
                </div>
                <button class="logout-button" onclick="logout()" title="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">PICKLEBALL CHAMPION</h1>
            <p class="hero-tagline">Enter the ultimate arena. Prove your skills. Become a legend.</p>
            <a href="#gamePlayer" class="play-now-btn">PLAY NOW</a>
        </div>
    </section>

    <!-- GAME PLAYER -->
    <section id="gamePlayer" class="game-player">
        <div class="game-placeholder" id="gamePlaceholder">
            <div class="placeholder-content">
                <button class="run-game-btn" onclick="startGame()">
                    <i class="fas fa-play"></i> LAUNCH GAME
                </button>
            </div>
        </div>
        <button class="fullscreen-btn" onclick="toggleFullscreen()" id="fullscreenButton" style="display:none;">
            <i class="fas fa-expand"></i>
        </button>
    </section>

    <div class="big-spacing"></div>

    <!-- FEATURES SECTION -->
    <section id="features" class="features-section">
        <div class="glass-panel feature-card">
            <i class="fas fa-gamepad feature-icon"></i>
            <h3>Intense Gameplay</h3>
            <p>Experience fast-paced, highly competitive matches with realistic physics and stunning visuals.</p>
        </div>
        <div class="glass-panel feature-card">
            <i class="fas fa-globe feature-icon"></i>
            <h3>Global Multiplayer</h3>
            <p>Challenge players from around the world and climb the leaderboards to prove your worth.</p>
        </div>
        <div class="glass-panel feature-card">
            <i class="fas fa-trophy feature-icon"></i>
            <h3>Tournaments</h3>
            <p>Participate in weekly tournaments to win exclusive rewards and secure your legacy.</p>
        </div>
    </section>

    <div class="big-spacing"></div>

    <!-- INTRODUCTION -->
    <section id="introduction">
        <h2 class="section-title">The <span>Arena</span> Awaits</h2>
        <div class="glass-panel">
            <h3>
                Welcome, new challengers, to Pickleball Champion!<br><br>
                This is the ultimate test of reflexes, strategy, and sheer will. The arena is unforgiving, but the glory is eternal. Enter now, and prove the true power of your skills.<br><br>
                Do you have what it takes to rise above the rest? Step forward!
            </h3>
        </div>
    </section>

    <div class="big-spacing"></div>

    <!-- DONATE SECTION -->
    <section id="donate">
        <h2 class="section-title">Support <span>Development</span></h2>
        <div class="glass-panel" style="padding: 40px; text-align: center;">
            <p style="color: #a0aec0; margin-bottom: 30px; font-size: 1.1rem;">
                Help us keep the servers running and bring more amazing updates to the game!
            </p>
            <button class="donate-btn" onclick="showDonateForm()">
                <i class="fas fa-heart"></i> BECOME A SUPPORTER
            </button>
        </div>
    </section>

    <div class="big-spacing"></div>

    <!-- UPDATES SECTION -->
    <section class="updates-section" id="updatesSection">
        <div class="glass-panel updates-container">
            <div class="updates-header">
                <h2><i class="fas fa-bullhorn"></i> Latest News <span class="updates-count" id="updatesCount">(0)</span></h2>
                <div class="search-updates">
                    <input type="text" id="searchUpdates" placeholder="Search news..." onkeyup="filterUpdates()">
                </div>
            </div>

            <!-- Slider / Previews -->
            <div id="updatesSlider" style="display: none;">
                <div class="slider-header">
                    <h3>Announcements <span id="updateCounter">1/5</span></h3>
                    <button id="showAllUpdates" class="btn btn-outline-info btn-sm" onclick="toggleShowAll()">Show All</button>
                </div>
                <div id="updateSlides"></div>
            </div>

            <div id="updatePreviews" style="display: none;"></div>
            
            <div id="noUpdates" style="display: none; text-align:center; padding: 40px; color: #666;">
                <i class="fas fa-inbox fa-3x mb-3"></i>
                <h4>No news yet</h4>
            </div>
        </div>
    </section>

    <div class="big-spacing"></div>

    <!-- COMMENTS SECTION -->
    <section class="comments-section">
        <div class="glass-panel comments-container">
            <h2 class="section-title" style="text-align: left; font-size: 1.8rem; margin-bottom: 20px;">
                Community <span id="commentsCount">(0)</span>
            </h2>

            <div id="commentForm">
                <div id="loginToComment" style="text-align:center; padding: 20px;">
                    <a href="#" onclick="showAuthModal('login')" style="color: var(--accent-cyan);">Login to join the discussion</a>
                </div>

                <div id="commentInputSection" style="display: none;">
                    <textarea id="commentInput" class="comment-input" placeholder="What are your thoughts?"></textarea>
                    <div style="text-align: right;">
                        <button class="cancel-btn" onclick="clearCommentInput()">Clear</button>
                        <button class="submit-btn" onclick="submitComment()">Post</button>
                    </div>
                </div>
            </div>

            <div id="commentsList" style="margin-top: 30px;"></div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-brand">
                <h2>Pickleball <span>Champion</span></h2>
                <p>The ultimate competitive web gaming experience. Play, compete, and conquer.</p>
            </div>
            <div class="footer-links">
                <h4>Navigation</h4>
                <ul>
                    <li><a href="#introduction">Story</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#updatesSection">News</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4>Legal</h4>
                <ul>
                    <li><a href="#">Terms of Service</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2025 Pickleball Champion. All rights reserved.
        </div>
    </footer>


    <!-- MODALS -->
    <!-- AUTH MODAL -->
    <div class="auth-modal" id="authModal" style="display: none;">
        <div class="modal-content">
            <span class="close-modal" onclick="closeAuthModal()">&times;</span>
            <h2 id="modalTitle">Log in</h2>
            <div class="auth-form">
                <div id="usernameField" style="display: none;">
                    <input type="text" id="authUsername" placeholder="Username" maxlength="20">
                </div>
                <input type="email" id="authEmail" placeholder="Email address" maxlength="50">
                <input type="password" id="authPassword" placeholder="Password" maxlength="30">
                
                <button id="authSubmitBtn" onclick="handleAuthSubmit()">Log in</button>
                
                <p class="auth-switch" id="authSwitch">
                    Don't have an account? <a href="#" onclick="toggleAuthMode()">Sign up</a>
                </p>
                <p class="auth-error" id="authError"></p>
            </div>
        </div>
    </div>

    <!-- ADMIN PANEL -->
    <div class="admin-panel" id="adminPanel" style="display: none;">
        <button class="admin-toggle-btn" onclick="toggleAdminPanel()">
            <i class="fas fa-cogs"></i> Admin
        </button>
        
        <div class="admin-modal" id="adminModal" style="display: none;">
            <div class="admin-modal-content">
                <span class="close-modal" style="right:30px; top:30px;" onclick="closeAdminModal()">&times;</span>
                <h2 style="color:#fff; margin-bottom:20px; font-family: var(--font-heading);">Admin Dashboard</h2>

                <div class="admin-stats">
                    <div class="stat-card">
                        <div class="stat-number" id="totalUsers">0</div>
                        <div style="color:#a0aec0">Users</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="totalComments">0</div>
                        <div style="color:#a0aec0">Comments</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="bannedUsers">0</div>
                        <div style="color:#a0aec0">Banned</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="totalUpdates">0</div>
                        <div style="color:#a0aec0">Updates</div>
                    </div>
                </div>

                <div class="admin-tabs">
                    <button class="admin-tab active" onclick="openAdminTab('users')">Users</button>
                    <button class="admin-tab" onclick="openAdminTab('comments')">Comments</button>
                    <button class="admin-tab" onclick="openAdminTab('notifications')">Notifications</button>
                </div>

                <div id="notificationsTab" class="admin-tab-content">
                    <button class="btn btn-primary mb-3" onclick="showNotificationForm()">+ Add Notification</button>
                    <div id="notificationsList"></div>
                </div>
                <div id="usersTab" class="admin-tab-content active">
                    <input type="text" id="searchUser" placeholder="Search users..." onkeyup="searchUsers()" style="width:100%; padding:10px; margin-bottom:15px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); color:#fff;">
                    <div id="usersList"></div>
                </div>
                <div id="commentsTab" class="admin-tab-content">
                    <input type="text" id="searchComment" placeholder="Search comments..." onkeyup="searchComments()" style="width:100%; padding:10px; margin-bottom:15px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); color:#fff;">
                    <div id="adminCommentsList"></div>
                </div>
            </div>
        </div>
    </div>


    <!-- SCRIPTS -->
    <script src="js/particles.js"></script>
    <script src="js/userSystem.js"></script>
    <script src="js/customModals.js"></script>
    <script src="js/main.js"></script>
    <script src="js/comments.js"></script>
    <script src="js/updates.js"></script>
    <script src="js/admin.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/payment.js"></script>

    <script>
        // Smooth reveal animations on scroll
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.glass-panel, .feature-card, .section-title').forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                el.style.transition = 'all 0.6s ease-out';
                observer.observe(el);
            });
            
            // Re-init full screen button display if needed
            document.getElementById('fullscreenButton').style.display = 'flex';
        });
    </script>
</body>
</html>